PORT=5000
NODE_ENV=development

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=JobMatch

JWT_SECRET=replace_with_a_long_random_hex_string
JWT_EXPIRES_IN=7d

# RapidAPI - JSearch
JSEARCH_API_KEY=
JSEARCH_API_HOST=jsearch.p.rapidapi.com
JSEARCH_BASE_URL=https://jsearch.p.rapidapi.com

# 'fixture' serves src/jobDummyData/ (no quota used); 'live' calls JSearch.
# Defaults to fixture unless NODE_ENV=production.
JOB_DATA_SOURCE=fixture

# RapidAPI - Affinda
AFFINDA_API_KEY=
AFFINDA_API_HOST=affinda-resume-parser.p.rapidapi.com
AFFINDA_BASE_URL=https://affinda-resume-parser.p.rapidapi.com

# Claude (optional)
CLAUDE_API_KEY=

# Cron
JOB_PULL_CRON=0 */4 * * *
COMMON_TITLES=software engineer,data analyst,product manager
COMMON_COUNTRIES=US,GB,NG,CA,DE

CLIENT_URL=http://localhost:3000

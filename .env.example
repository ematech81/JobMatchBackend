PORT=5000
NODE_ENV=development

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=JobMatch

JWT_SECRET=replace_with_a_long_random_hex_string
JWT_EXPIRES_IN=7d

# RapidAPI - JSearch
JSEARCH_API_KEY=
JSEARCH_API_HOST=jsearch.p.rapidapi.com
JSEARCH_BASE_URL=https://jsearch.p.rapidapi.com

# 'fixture' serves src/jobDummyData/ (no quota used); 'live' calls JSearch.
# Defaults to fixture unless NODE_ENV=production.
JOB_DATA_SOURCE=fixture

# Affinda (official direct API, not RapidAPI) - resume upload parsing (Path A)
# AFFINDA_WORKSPACE and AFFINDA_DOCUMENT_TYPE are identifiers from your
# Affinda workspace (Workspace -> Document Types -> Resume Parser). Both are
# required — without an explicit document type, extraction silently no-ops.
AFFINDA_API_KEY=
AFFINDA_WORKSPACE=
AFFINDA_DOCUMENT_TYPE=
AFFINDA_API_BASE=https://api.affinda.com

# Claude (optional)
CLAUDE_API_KEY=

# Cron
JOB_PULL_CRON=0 */4 * * *
COMMON_TITLES=software engineer,data analyst,product manager
COMMON_COUNTRIES=US,GB,NG,CA,DE

CLIENT_URL=http://localhost:3000

# Brevo - transactional email (new-match notifications, verification, password
# reset). Unset means emailService stays stubbed: sends are logged and
# skipped rather than attempted.
BREVO_API_KEY=
# Must be a sender verified in the Brevo dashboard (Settings > Senders) or
# sends will fail.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=JobMatch

# KoraPay - subscription checkout. Unset means korapayService stays stubbed:
# plan selections are still recorded, but no real charge is initiated. These
# are LIVE keys in production — real charges.
KORAPAY_SECRET_KEY=
KORAPAY_PUBLIC_KEY=
KORAPAY_BASE_URL=https://api.korapay.com

# All webhooks arrive via the shared korapay-webhook-router (one router in
# front of KoraPay for every app on this account), not directly from KoraPay.
# Must match ROUTER_FORWARD_SECRET on the router's own deployment exactly —
# see subscriptionController.handleWebhook. Optional: if unset, the router-
# secret check is skipped and KoraPay's own HMAC signature is the sole check.
ROUTER_FORWARD_SECRET=

# Google Sign-In — verifies the ID token's audience matches this. Same value
# goes in web/.env as NEXT_PUBLIC_GOOGLE_CLIENT_ID. Only the Client ID is
# used anywhere in this app; the Client Secret is for the server-side OAuth
# code-exchange flow, which this app doesn't use.
GOOGLE_CLIENT_ID=

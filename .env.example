PORT=5000
NODE_ENV=development

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=JobMatch

JWT_SECRET=replace_with_a_long_random_hex_string
JWT_EXPIRES_IN=7d

# RapidAPI - JSearch
JSEARCH_API_KEY=
JSEARCH_API_HOST=jsearch.p.rapidapi.com
JSEARCH_BASE_URL=https://jsearch.p.rapidapi.com

# 'fixture' serves src/jobDummyData/ (no quota used); 'live' calls JSearch.
# Defaults to fixture unless NODE_ENV=production.
JOB_DATA_SOURCE=fixture

# Affinda (official direct API, not RapidAPI) - resume upload parsing (Path A)
# AFFINDA_WORKSPACE and AFFINDA_DOCUMENT_TYPE are identifiers from your
# Affinda workspace (Workspace -> Document Types -> Resume Parser). Both are
# required — without an explicit document type, extraction silently no-ops.
AFFINDA_API_KEY=
AFFINDA_WORKSPACE=
AFFINDA_DOCUMENT_TYPE=
AFFINDA_API_BASE=https://api.affinda.com

# Claude (optional)
CLAUDE_API_KEY=

# KoraPay - subscription checkout. Unset means korapayService stays stubbed:
# plan selections are still recorded, but no real charge is initiated.
KORAPAY_SECRET_KEY=
KORAPAY_PUBLIC_KEY=
KORAPAY_BASE_URL=https://api.korapay.com

# Cron
JOB_PULL_CRON=0 */4 * * *
COMMON_TITLES=software engineer,data analyst,product manager
COMMON_COUNTRIES=US,GB,NG,CA,DE

CLIENT_URL=http://localhost:3000
